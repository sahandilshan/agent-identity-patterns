---
import { statusStamp } from '../lib/data';
import { SITE } from '../lib/site';

const stamp = await statusStamp();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="about">
      <p class="name">{SITE.name}</p>
      {SITE.author && <p>{SITE.author}</p>}
      <p>Standards first, with ThunderID as the implementation. Not ThunderID documentation.</p>
    </div>
    <div class="links">
      <a href={SITE.repoUrl}>Source on GitHub</a>
      <a href={SITE.thunderidUrl}>ThunderID</a>
      <p class="mono stamp">{stamp}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
  }
  .inner {
    padding-block: 40px 56px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 24px;
  }
  .about {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 520px;
    font-size: 14px;
    color: var(--muted);
  }
  .name {
    font-weight: 700;
    font-size: 16px;
    color: var(--ink);
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
  }
  .stamp {
    font-size: 12px;
    color: var(--muted);
  }
</style>
