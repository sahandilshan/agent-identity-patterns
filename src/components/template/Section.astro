---
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---

<section class="template-section" aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{title}</h2>
  <div class="prose"><slot /></div>
</section>

<style>
  .template-section {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-block: 28px;
    border-top: 1px solid var(--rule);
  }
  h2 {
    font-size: 24px;
    letter-spacing: -0.015em;
    font-weight: 700;
  }
</style>
