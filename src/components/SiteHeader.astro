---
import { href } from '../lib/url';
import { SITE } from '../lib/site';

const links = [
  { label: 'The problem', path: 'problem/' },
  { label: 'Patterns', path: 'patterns/' },
  { label: 'Live demo', path: 'demo/' },
  { label: 'Build it with ThunderID', path: 'build/' },
];
const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={href()}>
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
        <path d="M12 2l8.66 5v10L12 22l-8.66-5V7z"></path>
        <circle cx="12" cy="12" r="3" fill="var(--accent)" stroke="none"></circle>
      </svg>
      <span>{SITE.name}</span>
    </a>
    <nav aria-label="Primary">
      {
        links.map((l) => (
          <a href={href(l.path)} aria-current={current.startsWith(href(l.path)) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    padding-block: 12px;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: var(--ink);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: -0.01em;
  }
  .brand:hover {
    color: var(--ink);
  }
  nav {
    display: flex;
    gap: 8px 24px;
    flex-wrap: wrap;
    font-size: 15px;
    font-weight: 500;
  }
  nav a {
    color: var(--ink);
    text-decoration: none;
    padding: 8px 0;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--accent);
  }
</style>
