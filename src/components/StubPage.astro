---
import BaseLayout from '../layouts/BaseLayout.astro';

/** A page that exists so navigation resolves. Marked draft, so a launch build fails on it. */
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description} draft>
  <section class="container page">
    <h1>{title}</h1>
    <p>{description}</p>
    <p class="note">This page is being written.</p>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: 56px 96px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 760px;
  }
  h1 {
    font-size: clamp(34px, 4.6vw, 52px);
    letter-spacing: -0.025em;
    line-height: 1.05;
  }
  p {
    font-size: 18px;
    color: var(--ink-soft);
  }
  .note {
    font-size: 15px;
    color: var(--muted-strong);
  }
</style>
