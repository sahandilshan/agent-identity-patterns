---
import PatternGrid from '../../components/PatternGrid.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { statusStamp } from '../../lib/data';

const stamp = await statusStamp();
---

<BaseLayout title="Patterns" description="Agent identity patterns, grouped by where they sit on the stack map.">
  <section class="container page">
    <div class="section-head">
      <h1>Patterns</h1>
      <p>Grouped by where they sit on the stack map: what the agent is, who may call it, and what it calls.</p>
    </div>
    <p class="mono stamp">{stamp}</p>
    <PatternGrid />
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: 56px 80px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  h1 {
    font-size: clamp(34px, 4.6vw, 52px);
    letter-spacing: -0.025em;
    line-height: 1.05;
  }
  .stamp {
    font-size: 12px;
    color: var(--muted-strong);
  }
</style>
